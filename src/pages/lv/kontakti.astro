---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/contacts");
if (!entry) throw new Error("Content entry 'lv/contacts' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/kontakti/"
  alternateUrl="/ru/kontakty/"
/>
