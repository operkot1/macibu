---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BlogPostTemplate from "../../../components/layout/BlogPostTemplate.astro";
import { blogSlug } from "../../../lib/blog/blogSlug";

export async function getStaticPaths() {
  const entries = await getCollection("blogPosts", (e) => e.data.lang === "lv");
  return entries.map((entry) => ({
    params: { slug: blogSlug(entry.data.route_id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"blogPosts"> };
const { Content } = await render(entry);
const slug = blogSlug(entry.data.route_id);
---

<BlogPostTemplate
  entry={entry}
  Content={Content}
  canonicalPath={`/lv/blogs/${slug}/`}
  alternateUrl={`/ru/blog/${slug}/`}
  blogIndexHref="/lv/blogs/"
  blogIndexLabel="← Izmaiņu jaunumi"
/>
