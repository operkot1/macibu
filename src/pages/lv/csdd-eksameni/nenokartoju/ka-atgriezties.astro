---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p2-nenokartoju-atgriezties");
if (!entry)
  throw new Error("Content entry 'lv/p2-nenokartoju-atgriezties' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/csdd-eksameni/nenokartoju/ka-atgriezties/"
  alternateUrl="/ru/ekzameny-csdd/ne-sdal/kak-vernutsya/"
/>
