---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p2-kapec-67");
if (!entry) throw new Error("Content entry 'lv/p2-kapec-67' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/csdd-eksameni/kapec-67-nenokarto/"
  alternateUrl="/ru/ekzameny-csdd/pochemu-67-ne-sdayut/"
/>
