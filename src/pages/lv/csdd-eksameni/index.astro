---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p2-index");
if (!entry) throw new Error("Content entry 'lv/p2-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/csdd-eksameni/"
  alternateUrl="/ru/ekzameny-csdd/"
/>
