---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p2-vadisana-ko-nemt");
if (!entry) throw new Error("Content entry 'lv/p2-vadisana-ko-nemt' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/csdd-eksameni/vadisana/ko-nemt-lidzi/"
  alternateUrl="/ru/ekzameny-csdd/vozhdenie/chto-vzyat-s-soboj/"
/>
