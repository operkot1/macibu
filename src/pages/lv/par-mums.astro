---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/about");
if (!entry) throw new Error("Content entry 'lv/about' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/par-mums/"
  alternateUrl="/ru/o-nas/"
/>
