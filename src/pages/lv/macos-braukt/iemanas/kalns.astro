---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p4-iemanas-kalns");
if (!entry) throw new Error("Content entry 'lv/p4-iemanas-kalns' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/macos-braukt/iemanas/kalns/"
  alternateUrl="/ru/uchus-vodit/navyki/podyom-v-gorku/"
/>
