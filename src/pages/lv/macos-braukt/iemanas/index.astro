---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p4-iemanas-index");
if (!entry) throw new Error("Content entry 'lv/p4-iemanas-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/macos-braukt/iemanas/"
  alternateUrl="/ru/uchus-vodit/navyki/"
/>
