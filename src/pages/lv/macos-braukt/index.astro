---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p4-index");
if (!entry) throw new Error("Content entry 'lv/p4-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/macos-braukt/"
  alternateUrl="/ru/uchus-vodit/"
/>
