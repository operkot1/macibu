---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p4-bailes-eksamena");
if (!entry) throw new Error("Content entry 'lv/p4-bailes-eksamena' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/macos-braukt/bailes/eksamena-bailes/"
  alternateUrl="/ru/uchus-vodit/strahi/strah-ekzamena/"
/>
