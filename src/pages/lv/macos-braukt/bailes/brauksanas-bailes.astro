---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p4-bailes-brauksanas");
if (!entry)
  throw new Error("Content entry 'lv/p4-bailes-brauksanas' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/macos-braukt/bailes/brauksanas-bailes/"
  alternateUrl="/ru/uchus-vodit/strahi/strah-vozhdeniya/"
/>
