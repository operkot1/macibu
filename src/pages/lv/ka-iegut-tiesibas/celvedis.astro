---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p1-celvedis");
if (!entry) throw new Error("Content entry 'lv/p1-celvedis' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/ka-iegut-tiesibas/celvedis/"
  alternateUrl="/ru/kak-poluchit-prava/rukovodstvo/"
/>
