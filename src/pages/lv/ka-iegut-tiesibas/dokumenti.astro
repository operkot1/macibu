---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p1-dokumenti");
if (!entry) throw new Error("Content entry 'lv/p1-dokumenti' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/ka-iegut-tiesibas/dokumenti/"
  alternateUrl="/ru/kak-poluchit-prava/dokumenty/"
/>
