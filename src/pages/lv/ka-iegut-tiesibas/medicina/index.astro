---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p1-medicina-index");
if (!entry) throw new Error("Content entry 'lv/p1-medicina-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/ka-iegut-tiesibas/medicina/"
  alternateUrl="/ru/kak-poluchit-prava/medicina/"
/>
