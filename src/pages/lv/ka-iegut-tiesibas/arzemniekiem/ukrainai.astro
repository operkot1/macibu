---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p1-arzemniekiem-ukrainai");
if (!entry)
  throw new Error("Content entry 'lv/p1-arzemniekiem-ukrainai' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/ka-iegut-tiesibas/arzemniekiem/ukrainai/"
  alternateUrl="/ru/kak-poluchit-prava/inostrancam/dlya-grazhdan-ukrainy/"
/>
