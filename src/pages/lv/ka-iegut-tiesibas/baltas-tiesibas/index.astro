---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p1-baltas-tiesibas-index");
if (!entry)
  throw new Error("Content entry 'lv/p1-baltas-tiesibas-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/ka-iegut-tiesibas/baltas-tiesibas/"
  alternateUrl="/ru/kak-poluchit-prava/belye-prava/"
/>
