---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p1-vecums");
if (!entry) throw new Error("Content entry 'lv/p1-vecums' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/ka-iegut-tiesibas/vecums/"
  alternateUrl="/ru/kak-poluchit-prava/vozrast/"
/>
