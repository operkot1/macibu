---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/privacy");
if (!entry) throw new Error("Content entry 'lv/privacy' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/privatuma-politika/"
  alternateUrl="/ru/politika-konfidencialnosti/"
/>
