---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p3-slepti-maksajumi");
if (!entry) throw new Error("Content entry 'lv/p3-slepti-maksajumi' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/autoskolas/slepti-maksajumi/"
  alternateUrl="/ru/avtoshkoly/skrytye-platezhi/"
/>
