---
import { getCollection, getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";
import {
  categoryCode,
  sortByCategoryOrder,
} from "../../../lib/categories/categoryOrder";

const entry = await getEntry("pages", "lv/cat-index");
if (!entry) throw new Error("Content entry 'lv/cat-index' not found");
const { Content } = await render(entry);

const categoryEntries = await getCollection(
  "pages",
  (e) => e.data.pageType === "category" && e.data.lang === "lv",
);
const categories = sortByCategoryOrder(categoryEntries.map((e) => e.data)).map(
  (data) => ({
    title: data.title,
    description: data.description,
    href: `/lv/kategorijas/${categoryCode(data.route_id)}/`,
  }),
);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  categories={categories}
  canonicalPath="/lv/kategorijas/"
  alternateUrl="/ru/kategorii/"
/>
