---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "lv/cat-be");
if (!entry) throw new Error("Content entry 'lv/cat-be' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/kategorijas/be/"
  alternateUrl="/ru/kategorii/be/"
/>
