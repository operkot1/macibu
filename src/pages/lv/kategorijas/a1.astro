---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "lv/cat-a1");
if (!entry) throw new Error("Content entry 'lv/cat-a1' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/kategorijas/a1/"
  alternateUrl="/ru/kategorii/a1/"
/>
