---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "lv/cat-a");
if (!entry) throw new Error("Content entry 'lv/cat-a' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/kategorijas/a/"
  alternateUrl="/ru/kategorii/a/"
/>
