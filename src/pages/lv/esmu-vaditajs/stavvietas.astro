---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p5-stavvietas");
if (!entry) throw new Error("Content entry 'lv/p5-stavvietas' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/esmu-vaditajs/stavvietas/"
  alternateUrl="/ru/ya-voditel/stoyanki/"
/>
