---
import { getCollection } from "astro:content";
import ToolPageTemplate from "../../../components/layout/ToolPageTemplate.astro";
import Callout from "../../../components/content/Callout.astro";
import ViolationSearch from "../../../components/tools/violations/ViolationSearch.tsx";
import {
  POINTS_THRESHOLDS,
  POINTS_SOURCE_CITATION,
  POINTS_VALIDITY_TEXT,
} from "../../../lib/points/pointsThresholds";

const entries = await getCollection("violations");
const violations = entries.map((e) => e.data);
---

<ToolPageTemplate
  currentLocale="lv"
  routeId="p5-sodi"
  title="Sodi par pārkāpumiem"
  description="Kā darbojas pārkāpumu uzskaites punktu sistēma Latvijā, un ilustratīvs pārkāpumu meklētājs pēc kategorijas, punktiem un soda summas."
  heading="Sodi par pārkāpumiem"
  intro="Kā darbojas punktu sistēma, un meklētājs pēc konkrētiem pārkāpumiem."
  canonicalPath="/lv/esmu-vaditajs/sodi/"
  alternateUrl="/ru/ya-voditel/shtrafy/"
>
  <h2 class="text-h2 text-neutral-900 mb-2">Kā darbojas punktu sistēma</h2>
  <p class="text-body text-neutral-900 mb-4">
    {POINTS_VALIDITY_TEXT.lv}
  </p>
  <ul class="text-body text-neutral-900 mb-4 flex flex-col gap-1">
    {
      POINTS_THRESHOLDS.map((t) => (
        <li>
          {t.points} punkti — {t.description_lv}
        </li>
      ))
    }
  </ul>
  <p class="text-body-sm text-neutral-600 mb-6">
    {POINTS_SOURCE_CITATION.lv}
  </p>
  <p class="text-body-sm text-neutral-600 mb-6">
    → <a href="/lv/esmu-vaditajs/punkti/" class="text-primary-600 underline">
      Punktu kalkulators
    </a> — aprēķini savu statusu pēc konkrētiem pārkāpumiem.
  </p>

  <Callout tone="warning" title="Ilustratīvi dati">
    <p>
      Zemāk redzamās konkrētās soda summas un punktu vērtības par atsevišķiem
      pārkāpumiem ir ilustratīvas, ne oficiāls, apstiprināts reģistrs —
      precīzas, aktuālas summas skaties CSDD vai likumi.lv. Punktu sistēmas
      apraksts augstāk ir pārbaudīts pret oficiāliem avotiem.
    </p>
  </Callout>

  <div class="mt-6">
    <ViolationSearch
      client:visible
      violations={violations}
      currentLocale="lv"
    />
  </div>
</ToolPageTemplate>
