---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "lv/p5-pirma-masina-registracija");
if (!entry)
  throw new Error("Content entry 'lv/p5-pirma-masina-registracija' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/lv/esmu-vaditajs/pirma-masina/registracija/"
  alternateUrl="/ru/ya-voditel/pervaya-mashina/registraciya/"
/>
