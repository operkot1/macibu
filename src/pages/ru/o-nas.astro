---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/about");
if (!entry) throw new Error("Content entry 'ru/about' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/o-nas/"
  alternateUrl="/lv/par-mums/"
/>
