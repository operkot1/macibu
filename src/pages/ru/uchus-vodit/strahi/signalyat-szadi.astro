---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p4-bailes-signale");
if (!entry) throw new Error("Content entry 'ru/p4-bailes-signale' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/uchus-vodit/strahi/signalyat-szadi/"
  alternateUrl="/lv/macos-braukt/bailes/signale-no-aizmugures/"
/>
