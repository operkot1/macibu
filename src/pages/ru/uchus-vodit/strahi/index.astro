---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p4-bailes-index");
if (!entry) throw new Error("Content entry 'ru/p4-bailes-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/uchus-vodit/strahi/"
  alternateUrl="/lv/macos-braukt/bailes/"
/>
