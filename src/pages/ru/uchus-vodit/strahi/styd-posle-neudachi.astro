---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p4-bailes-kauns");
if (!entry) throw new Error("Content entry 'ru/p4-bailes-kauns' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/uchus-vodit/strahi/styd-posle-neudachi/"
  alternateUrl="/lv/macos-braukt/bailes/kauns-pec-neveiksmes/"
/>
