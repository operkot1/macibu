---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p4-iemanas-sajugs");
if (!entry) throw new Error("Content entry 'ru/p4-iemanas-sajugs' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/uchus-vodit/navyki/sceplenie/"
  alternateUrl="/lv/macos-braukt/iemanas/sajugs/"
/>
