---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p4-iemanas-parbuve");
if (!entry) throw new Error("Content entry 'ru/p4-iemanas-parbuve' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/uchus-vodit/navyki/perestroenie/"
  alternateUrl="/lv/macos-braukt/iemanas/parbuve/"
/>
