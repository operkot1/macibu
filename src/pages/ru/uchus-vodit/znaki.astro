---
import ToolPageTemplate from "../../../components/layout/ToolPageTemplate.astro";
import TrafficSignSearch from "../../../components/tools/traffic-signs/TrafficSignSearch.tsx";
import { getTrafficSigns } from "../../../lib/data";

const signs = getTrafficSigns().signs;
---

<ToolPageTemplate
  currentLocale="ru"
  routeId="p4-zimes"
  title="Справочник дорожных знаков"
  description="Справочный материал по дорожным знакам с поиском — знаки приоритета с изображениями и пояснениями."
  heading="Дорожные знаки"
  intro="Ищи по номеру знака или названию. Доступны все 8 категорий — 300 знаков с изображениями и пояснениями."
  canonicalPath="/ru/uchus-vodit/znaki/"
  alternateUrl="/lv/macos-braukt/zimes/"
>
  <TrafficSignSearch client:visible signs={signs} currentLocale="ru" />
</ToolPageTemplate>
