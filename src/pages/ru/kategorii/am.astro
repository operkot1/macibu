---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "ru/cat-am");
if (!entry) throw new Error("Content entry 'ru/cat-am' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kategorii/am/"
  alternateUrl="/lv/kategorijas/am/"
/>
