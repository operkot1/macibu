---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "ru/cat-b1");
if (!entry) throw new Error("Content entry 'ru/cat-b1' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kategorii/b1/"
  alternateUrl="/lv/kategorijas/b1/"
/>
