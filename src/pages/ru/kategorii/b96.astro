---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "ru/cat-b96");
if (!entry) throw new Error("Content entry 'ru/cat-b96' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kategorii/b96/"
  alternateUrl="/lv/kategorijas/b96/"
/>
