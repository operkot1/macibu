---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "ru/cat-a2");
if (!entry) throw new Error("Content entry 'ru/cat-a2' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kategorii/a2/"
  alternateUrl="/lv/kategorijas/a2/"
/>
