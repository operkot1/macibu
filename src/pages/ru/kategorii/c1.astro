---
import { getEntry, render } from "astro:content";
import CategoryHubTemplate from "../../../components/layout/CategoryHubTemplate.astro";

const entry = await getEntry("pages", "ru/cat-c1");
if (!entry) throw new Error("Content entry 'ru/cat-c1' not found");
const { Content } = await render(entry);
---

<CategoryHubTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kategorii/c1/"
  alternateUrl="/lv/kategorijas/c1/"
/>
