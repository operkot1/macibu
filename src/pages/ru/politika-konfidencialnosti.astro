---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/privacy");
if (!entry) throw new Error("Content entry 'ru/privacy' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/politika-konfidencialnosti/"
  alternateUrl="/lv/privatuma-politika/"
/>
