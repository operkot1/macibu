---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/contacts");
if (!entry) throw new Error("Content entry 'ru/contacts' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kontakty/"
  alternateUrl="/lv/kontakti/"
/>
