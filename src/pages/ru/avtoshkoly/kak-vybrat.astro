---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p3-ka-izveleties");
if (!entry) throw new Error("Content entry 'ru/p3-ka-izveleties' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/avtoshkoly/kak-vybrat/"
  alternateUrl="/lv/autoskolas/ka-izveleties/"
/>
