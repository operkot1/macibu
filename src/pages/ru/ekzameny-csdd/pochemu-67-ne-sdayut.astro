---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p2-kapec-67");
if (!entry) throw new Error("Content entry 'ru/p2-kapec-67' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ekzameny-csdd/pochemu-67-ne-sdayut/"
  alternateUrl="/lv/csdd-eksameni/kapec-67-nenokarto/"
/>
