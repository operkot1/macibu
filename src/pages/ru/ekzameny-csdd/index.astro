---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p2-index");
if (!entry) throw new Error("Content entry 'ru/p2-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ekzameny-csdd/"
  alternateUrl="/lv/csdd-eksameni/"
/>
