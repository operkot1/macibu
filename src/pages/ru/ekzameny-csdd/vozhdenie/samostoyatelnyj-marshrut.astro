---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p2-vadisana-patstaviga");
if (!entry)
  throw new Error("Content entry 'ru/p2-vadisana-patstaviga' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ekzameny-csdd/vozhdenie/samostoyatelnyj-marshrut/"
  alternateUrl="/lv/csdd-eksameni/vadisana/patstaviga-brauksana/"
/>
