---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p2-vadisana-index");
if (!entry) throw new Error("Content entry 'ru/p2-vadisana-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ekzameny-csdd/vozhdenie/"
  alternateUrl="/lv/csdd-eksameni/vadisana/"
/>
