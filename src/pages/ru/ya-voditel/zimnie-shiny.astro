---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p5-ziemas-riepas");
if (!entry) throw new Error("Content entry 'ru/p5-ziemas-riepas' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ya-voditel/zimnie-shiny/"
  alternateUrl="/lv/esmu-vaditajs/ziemas-riepas/"
/>
