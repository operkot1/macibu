---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p5-pirma-masina-kasko");
if (!entry)
  throw new Error("Content entry 'ru/p5-pirma-masina-kasko' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ya-voditel/pervaya-mashina/kasko/"
  alternateUrl="/lv/esmu-vaditajs/pirma-masina/kasko/"
/>
