---
import { getCollection } from "astro:content";
import ToolPageTemplate from "../../../components/layout/ToolPageTemplate.astro";
import Callout from "../../../components/content/Callout.astro";
import ViolationSearch from "../../../components/tools/violations/ViolationSearch.tsx";
import {
  POINTS_THRESHOLDS,
  POINTS_SOURCE_CITATION,
  POINTS_VALIDITY_TEXT,
} from "../../../lib/points/pointsThresholds";

const entries = await getCollection("violations");
const violations = entries.map((e) => e.data);
---

<ToolPageTemplate
  currentLocale="ru"
  routeId="p5-sodi"
  title="Штрафы за нарушения"
  description="Как работает система баллов за нарушения в Латвии, и иллюстративный поиск по нарушениям — категория, баллы, сумма штрафа."
  heading="Штрафы за нарушения"
  intro="Как работает система баллов, и поиск по конкретным нарушениям."
  canonicalPath="/ru/ya-voditel/shtrafy/"
  alternateUrl="/lv/esmu-vaditajs/sodi/"
>
  <h2 class="text-h2 text-neutral-900 mb-2">Как работает система баллов</h2>
  <p class="text-body text-neutral-900 mb-4">
    {POINTS_VALIDITY_TEXT.ru}
  </p>
  <ul class="text-body text-neutral-900 mb-4 flex flex-col gap-1">
    {
      POINTS_THRESHOLDS.map((t) => (
        <li>
          {t.points} баллов — {t.description_ru}
        </li>
      ))
    }
  </ul>
  <p class="text-body-sm text-neutral-600 mb-6">
    {POINTS_SOURCE_CITATION.ru}
  </p>
  <p class="text-body-sm text-neutral-600 mb-6">
    →{" "}
    <a href="/ru/ya-voditel/punkty/" class="text-primary-600 underline">
      Калькулятор баллов
    </a>{" "}
    — рассчитай свой статус по конкретным нарушениям.
  </p>

  <Callout tone="warning" title="Частично иллюстративные данные">
    <p>
      Категории Скорость, Алкоголь, Телефон, Ремень безопасности и
      Остановка/стоянка ниже основаны на реальном источнике (parkapums.lv, со
      ссылкой на конкретную статью Ceļu satiksmes likums для каждой строки) —
      суммы и баллы не выдуманы. Категории Документы и Красный сигнал пока
      иллюстративные (источник недостаточно надёжно подтверждён) — каждая такая
      строка отмечена видимым бейджем «Иллюстративные данные». Точные,
      юридически значимые суммы всегда смотри на CSDD или likumi.lv. Описание
      системы баллов выше проверено по официальным источникам.
    </p>
  </Callout>

  <div class="mt-6">
    <ViolationSearch
      client:visible
      violations={violations}
      currentLocale="ru"
    />
  </div>
</ToolPageTemplate>
