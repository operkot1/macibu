---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p5-policija");
if (!entry) throw new Error("Content entry 'ru/p5-policija' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/ya-voditel/policiya/"
  alternateUrl="/lv/esmu-vaditajs/policija/"
/>
