---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p1-medicina-atteikums");
if (!entry)
  throw new Error("Content entry 'ru/p1-medicina-atteikums' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kak-poluchit-prava/medicina/otkaz/"
  alternateUrl="/lv/ka-iegut-tiesibas/medicina/atteikums/"
/>
