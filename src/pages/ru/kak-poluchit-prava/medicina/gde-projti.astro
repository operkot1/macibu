import MedicalCheckLocationList from "../../../../components/tools/medical-checks/MedicalCheckLocationList.tsx";
import { getMedicalCheckLocations } from "../../../../lib/data";

const locations = getMedicalCheckLocations().locations;
---

<ToolPageTemplate
  currentLocale="ru"
  routeId="p1-medicina-kur-iziet"
  title="Где пройти медицинский осмотр"
  description="Список мест, где можно пройти медицинский осмотр для получения водительских прав — фильтр по городу."
