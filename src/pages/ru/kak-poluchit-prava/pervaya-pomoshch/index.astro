---
import { getEntry, render } from "astro:content";
import ArticleTemplate from "../../../../components/layout/ArticleTemplate.astro";

const entry = await getEntry("pages", "ru/p1-pirma-palidziba-index");
if (!entry)
  throw new Error("Content entry 'ru/p1-pirma-palidziba-index' not found");
const { Content } = await render(entry);
---

<ArticleTemplate
  entry={entry}
  Content={Content}
  canonicalPath="/ru/kak-poluchit-prava/pervaya-pomoshch/"
  alternateUrl="/lv/ka-iegut-tiesibas/pirma-palidziba/"
/>
