---
// FAQ — docs/05-components.md §3. <details>/<summary> — нативная
// доступность, работает без JS. Генерирует FAQPage Schema.org
// автоматически из тех же пропсов (docs/07-i18n-seo.md §8) — разметка не
// дублируется вручную в MDX.
import { toSafeJsonLdString } from "../../lib/seo/safeJsonLd";

export interface FAQItem {
  question: string;
  answer: string;
}

export interface FAQProps {
  items: FAQItem[];
}

const { items }: FAQProps = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<div class="flex flex-col gap-2">
  {
    items.map((item) => (
      <details class="border-neutral-300 rounded-md border p-4">
        <summary class="text-h3 text-neutral-900 focus-visible:ring-focus-ring cursor-pointer rounded-md">
          {item.question}
        </summary>
        <div class="text-body text-neutral-900 mt-2" set:html={item.answer} />
      </details>
    ))
  }
</div>

<script type="application/ld+json" set:html={toSafeJsonLdString(jsonLd)} />
