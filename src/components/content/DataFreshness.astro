---
// DataFreshness — docs/05-components.md §3.
// updatedAt: string | null — в исходном контракте было заявлено как
// обязательный string, но состояние "unknown" буквально описано как
// "нет данных", что required-строка исключает. Поправлено здесь и в
// docs/05-components.md на nullable.
// locale — добавлено сверх исходного контракта: без него компонент
// хардкодил русский текст независимо от языка страницы (найдено при
// интеграции в Footer, T-014, — реальный баг смешения языков на LV-версии).

export interface DataFreshnessProps {
  label: string;
  updatedAt: string | null;
  staleAfterDays: number;
  locale: "lv" | "ru";
}

const { label, updatedAt, staleAfterDays, locale }: DataFreshnessProps =
  Astro.props;

type FreshnessState = "fresh" | "stale" | "unknown";

function computeState(
  updatedAt: string | null,
  staleAfterDays: number,
): FreshnessState {
  if (updatedAt === null) return "unknown";
  const updatedDate = new Date(updatedAt);
  if (Number.isNaN(updatedDate.getTime())) return "unknown";
  const daysSince =
    (Date.now() - updatedDate.getTime()) / (1000 * 60 * 60 * 24);
  return daysSince > staleAfterDays ? "stale" : "fresh";
}

function formatDate(updatedAt: string, locale: "lv" | "ru"): string {
  return new Date(updatedAt).toLocaleDateString(
    locale === "lv" ? "lv-LV" : "ru-LV",
    { year: "numeric", month: "2-digit", day: "2-digit" },
  );
}

const state = computeState(updatedAt, staleAfterDays);

const toneClass: Record<FreshnessState, string> = {
  fresh: "text-success-600",
  stale: "text-warning-600",
  unknown: "text-neutral-600",
};

const phrases = {
  lv: {
    fresh: (d: string) => `${label}: pārbaudīts ${d}`,
    stale: (d: string) => `${label}: atjaunots ${d} — pārbaudām aktualitāti`,
    unknown: () => `${label}: nav datu`,
  },
  ru: {
    fresh: (d: string) => `${label}: проверено ${d}`,
    stale: (d: string) => `${label}: обновлено ${d} — проверяем актуальность`,
    unknown: () => `${label}: нет данных`,
  },
} as const;

function buildText(state: FreshnessState): string {
  if (state === "unknown") return phrases[locale].unknown();
  const formatted = formatDate(updatedAt as string, locale);
  return state === "fresh"
    ? phrases[locale].fresh(formatted)
    : phrases[locale].stale(formatted);
}

const text = buildText(state);
---

<p class:list={["text-body-sm", toneClass[state]]} data-freshness-state={state}>
  {text}
</p>
