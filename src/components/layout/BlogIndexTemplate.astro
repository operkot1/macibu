---
// BlogIndexTemplate — /blogs/ (LV), /blog/ (RU) (T-115). Короткие пропы,
// как в ToolPageTemplate (не завязан на Content Collections `pages` —
// у индекса нет собственной длинной прозы), плюс список постов,
// переданный route-обёрткой из реального запроса к коллекции
// `blogPosts` (getCollection, отсортировано по publishedAt). Постов
// пока нет (T-116 ещё не сделана) — честный empty state, не пустой
// список молча.
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import LangSwitch from "./LangSwitch.astro";
import PhaseBar from "./PhaseBar.tsx";
import AnalyticsLayerA from "./AnalyticsLayerA.astro";
import CookieBanner from "./CookieBanner.tsx";
import { getCsddTariffs, getRatings } from "../../lib/data";
import "../../styles/base.css";

export interface BlogIndexPost {
  title: string;
  description: string;
  publishedAt: string;
  href: string;
}

export interface BlogIndexTemplateProps {
  currentLocale: "lv" | "ru";
  routeId: string;
  title: string;
  description: string;
  heading: string;
  intro: string;
  emptyStateText: string;
  posts: BlogIndexPost[];
  canonicalPath: string;
  alternateUrl: string | null;
}

const {
  currentLocale,
  routeId,
  title,
  description,
  heading,
  intro,
  emptyStateText,
  posts,
  canonicalPath,
  alternateUrl,
}: BlogIndexTemplateProps = Astro.props;

// Плейсхолдер-домен — docs/07-i18n-seo.md §3, до появления реального (В-4,
// docs/00-assumptions.md).
const baseUrl = "https://example.lv";

const lvPath = currentLocale === "lv" ? canonicalPath : alternateUrl;
const ruPath = currentLocale === "ru" ? canonicalPath : alternateUrl;

const csddTariffs = getCsddTariffs();
const ratings = getRatings();
---

<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${baseUrl}${canonicalPath}`} />
    {
      lvPath && (
        <link rel="alternate" hreflang="lv-LV" href={`${baseUrl}${lvPath}`} />
      )
    }
    {
      ruPath && (
        <link rel="alternate" hreflang="ru-LV" href={`${baseUrl}${ruPath}`} />
      )
    }
    {
      lvPath && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={`${baseUrl}${lvPath}`}
        />
      )
    }
  </head>
  <body>
    <AnalyticsLayerA routeId={routeId} />
    <Header currentLocale={currentLocale} currentRouteId={routeId}>
      <LangSwitch
        slot="lang-switch"
        currentLocale={currentLocale}
        alternateUrl={alternateUrl}
      />
    </Header>
    <PhaseBar
      client:load
      variant="sticky-mobile"
      currentLocale={currentLocale}
    />
    <PhaseBar
      client:load
      variant="inline-desktop"
      currentLocale={currentLocale}
    />
    <main class="p-4">
      <h1 class="text-h1 text-neutral-900 mb-4">{heading}</h1>
      <p class="text-body text-neutral-900 mb-6">{intro}</p>
      {
        posts.length === 0 ? (
          <p class="text-body text-neutral-600">{emptyStateText}</p>
        ) : (
          <ul class="flex flex-col gap-4">
            {posts.map((post) => (
              <li class="border-neutral-300 rounded-md border p-4">
                <a
                  href={post.href}
                  class="focus-visible:ring-focus-ring rounded-md hover:underline focus-visible:ring-2"
                >
                  <p class="text-h3 text-neutral-900 mb-1">{post.title}</p>
                </a>
                <p class="text-body-sm text-neutral-600 mb-1">
                  {post.publishedAt}
                </p>
                <p class="text-body-sm text-neutral-600">{post.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </main>
    <Footer
      currentLocale={currentLocale}
      dataFreshness={{
        csddTariffsUpdatedAt: csddTariffs.updated_at,
        ratingsUpdatedAt: ratings.updated_at,
      }}
    />
    <CookieBanner client:load currentLocale={currentLocale} />
  </body>
</html>
