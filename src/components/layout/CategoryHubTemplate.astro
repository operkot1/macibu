---
// CategoryHubTemplate — шаблон для /kategorijas/* (T-112). Единственный
// шаблон в реестре, названный для двух разных форм страницы одновременно
// (docs/02-routes.md: `cat-index` и `cat-a`…`cat-95-kods` указывают один
// и тот же шаблон) — в отличие от всех предыдущих *-index хабов сессии,
// где имя шаблона в реестре было фантомным и решалось переиспользованием
// ArticleTemplate, здесь DoD T-112 отдельно считает «SK-Инструмент
// (шаблон)» как самостоятельную единицу, не просто контент. Поэтому две
// формы страницы — один компонент с ветвлением по пропам:
// - hub-режим (`categories` передан): короткое вступление из
//   `cat-index.mdx` (Content) рендерится как обычно, ПОД ним — сетка
//   карточек, построенная из реального Content Collection query
//   (route.astro делает getCollection с фильтром
//   pageType==="category"), не из вручную поддерживаемого списка ссылок
//   — так хаб не может разойтись с реальным набором категорий.
// - leaf-режим (`categories` не передан): рендерится только Content,
//   как в ArticleTemplate — сами страницы категорий уже содержат
//   собственные "Saistītās kategorijas"/обратные ссылки в тексте
//   (написаны в T-111), шаблон их не дублирует.
import { render, type CollectionEntry } from "astro:content";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import LangSwitch from "./LangSwitch.astro";
import PhaseBar from "./PhaseBar.tsx";
import AnalyticsLayerA from "./AnalyticsLayerA.astro";
import CookieBanner from "./CookieBanner.tsx";
import { getCsddTariffs, getRatings } from "../../lib/data";
import "../../styles/base.css";

type RenderResult = Awaited<ReturnType<typeof render>>;

export interface CategoryCard {
  title: string;
  description: string;
  href: string;
}

export interface CategoryHubTemplateProps {
  entry: CollectionEntry<"pages">;
  canonicalPath: string;
  alternateUrl: string | null;
  Content?: RenderResult["Content"];
  categories?: CategoryCard[];
}

const {
  entry,
  Content,
  categories,
  canonicalPath,
  alternateUrl,
}: CategoryHubTemplateProps = Astro.props;
const { route_id, lang, title, description } = entry.data;

// Плейсхолдер-домен — docs/07-i18n-seo.md §3, до появления реального (В-4,
// docs/00-assumptions.md).
const baseUrl = "https://example.lv";

const lvPath = lang === "lv" ? canonicalPath : alternateUrl;
const ruPath = lang === "ru" ? canonicalPath : alternateUrl;

const csddTariffs = getCsddTariffs();
const ratings = getRatings();
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${baseUrl}${canonicalPath}`} />
    {
      lvPath && (
        <link rel="alternate" hreflang="lv-LV" href={`${baseUrl}${lvPath}`} />
      )
    }
    {
      ruPath && (
        <link rel="alternate" hreflang="ru-LV" href={`${baseUrl}${ruPath}`} />
      )
    }
    {
      lvPath && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={`${baseUrl}${lvPath}`}
        />
      )
    }
  </head>
  <body>
    <AnalyticsLayerA routeId={route_id} />
    <Header currentLocale={lang} currentRouteId={route_id}>
      <LangSwitch
        slot="lang-switch"
        currentLocale={lang}
        alternateUrl={alternateUrl}
      />
    </Header>
    <PhaseBar client:load variant="sticky-mobile" currentLocale={lang} />
    <PhaseBar client:load variant="inline-desktop" currentLocale={lang} />
    <main class="p-4">
      <h1 class="text-h1 text-neutral-900 mb-4">{title}</h1>
      <div class="text-body text-neutral-900">
        {Content && <Content />}
        {
          categories && (
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {categories.map((c) => (
                <a
                  href={c.href}
                  class="border-neutral-300 block rounded-md border p-4 hover:bg-neutral-100"
                >
                  <p class="text-h3 text-neutral-900 mb-1">{c.title}</p>
                  <p class="text-body-sm text-neutral-600">{c.description}</p>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </main>
    <Footer
      currentLocale={lang}
      dataFreshness={{
        csddTariffsUpdatedAt: csddTariffs.updated_at,
        ratingsUpdatedAt: ratings.updated_at,
      }}
    />
    <CookieBanner client:load currentLocale={lang} />
  </body>
</html>
